<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <!-- Desktop Area Container -->
    <FrameLayout
        android:id="@+id/desktop_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/taskbar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Desktop Shortcuts Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_desktop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

    </FrameLayout>

    <!-- Start Menu Pop-up Card (DeX Style) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/start_menu_card"
        android:layout_width="480dp"
        android:layout_height="520dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/dex_start_menu_bg"
        app:layout_constraintBottom_toTopOf="@+id/taskbar_container"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Search Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_search_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search Icon" />

                <EditText
                    android:id="@+id/et_search_apps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_apps_hint"
                    android:textColor="@color/dex_text_primary"
                    android:textColorHint="@color/dex_text_secondary"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />

            </LinearLayout>

            <!-- App Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_start_menu"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <!-- Start Menu Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DeX Mode"
                    android:textSize="12sp"
                    android:textColor="@color/dex_text_secondary" />

                <ImageButton
                    android:id="@+id/btn_launcher_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_item_ripple"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Samsung DeX Bottom Taskbar -->
    <LinearLayout
        android:id="@+id/taskbar_container"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_taskbar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- DeX Start Menu Button -->
        <ImageButton
            android:id="@+id/btn_start_menu"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_item_ripple"
            android:src="@drawable/ic_dex_start"
            android:contentDescription="Start Menu" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/dex_taskbar_border" />

        <!-- Pinned & Running Apps in Taskbar -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_taskbar_apps"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <!-- System Tray Container -->
        <LinearLayout
            android:id="@+id/tray_status_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_item_ripple"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/img_wifi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_wifi"
                android:contentDescription="WiFi" />

            <ImageView
                android:id="@+id/img_battery"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_battery"
                android:contentDescription="Battery" />

            <TextView
                android:id="@+id/tv_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textSize="12sp"
                android:textColor="@color/dex_text_secondary"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/dex_text_primary" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sen, 10 Nov"
                    android:textSize="10sp"
                    android:textColor="@color/dex_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Show Desktop / Minimize All Button -->
        <View
            android:id="@+id/btn_show_desktop"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_item_ripple" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
